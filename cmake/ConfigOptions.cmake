include_guard(GLOBAL)

function(jy_app_load_dot_config output_compile_defs)
    set(_compile_defs)
    if(NOT EXISTS "${PROJECT_ROOT}/.config")
        message(FATAL_ERROR ".config file missing at ${PROJECT_ROOT}/.config")
    endif()

    file(STRINGS "${PROJECT_ROOT}/.config" _config_lines)
    foreach(_line IN LISTS _config_lines)
        string(STRIP "${_line}" _line_stripped)
        if(NOT _line_stripped OR _line_stripped MATCHES "^#" OR NOT _line_stripped MATCHES "=")
            continue()
        endif()

        string(FIND "${_line_stripped}" "=" _eq_pos)
        math(EXPR _value_start_pos "${_eq_pos} + 1")
        string(SUBSTRING "${_line_stripped}" 0 ${_eq_pos} _key)
        string(SUBSTRING "${_line_stripped}" ${_value_start_pos} -1 _value)
        string(STRIP "${_key}" _key)
        string(STRIP "${_value}" _value)

        set(_compile_value "${_value}")
        if(_value STREQUAL "y")
            set(_value "1")
            set(_compile_value "1")
        elseif(_value STREQUAL "n")
            set(_value "0")
            set(_compile_value "0")
        elseif(_value MATCHES "^\"\"$")
            set(_value "")
            set(_compile_value "")
        elseif(_value MATCHES "^\"(.*)\"$")
            string(REGEX REPLACE "^\"(.*)\"$" "\\1" _value "${_value}")
        endif()

        set(${_key} "${_value}" PARENT_SCOPE)
        list(APPEND _compile_defs "${_key}=${_compile_value}")
    endforeach()

    set(${output_compile_defs} "${_compile_defs}" PARENT_SCOPE)
endfunction()

function(jy_app_override_compile_defs input_compile_defs output_compile_defs)
    set(_compile_defs ${${input_compile_defs}})

    foreach(_override IN LISTS ARGN)
        string(REGEX REPLACE "=.*$" "" _override_key "${_override}")
        list(FILTER _compile_defs EXCLUDE REGEX "^${_override_key}(=|$)")
        list(APPEND _compile_defs "${_override}")
    endforeach()

    set(${output_compile_defs} "${_compile_defs}" PARENT_SCOPE)
endfunction()
